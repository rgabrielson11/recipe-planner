POSTGRES_USER=planner
POSTGRES_PASSWORD=plannerpass
POSTGRES_DB=recipe_planner

# Mealie integration — see README "Mealie integration" section.
# MEALIE_API_TOKEN is a service-to-service credential the backend uses to
# talk to your Mealie instance; it is never exposed to the browser/user.
MEALIE_BASE_URL=http://your-mealie-host:9000
MEALIE_API_TOKEN=
