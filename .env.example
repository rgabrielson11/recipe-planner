# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# ── Mealie ───────────────────────────────────────────────────────
# Your self-hosted Mealie instance URL (no trailing slash)
MEALIE_BASE_URL=http://192.168.1.x:9000

# Service account token — generate in Mealie → Profile → API Tokens
MEALIE_API_TOKEN=your-mealie-api-token-here

# ── Database ─────────────────────────────────────────────────────
# SQLite file path inside the container (mapped to ./data/db/ on host)
# Change only if you move the bind mount in docker-compose.yml
DATABASE_PATH=/app/data/recipe_planner.db

# ── Homepage dashboard ────────────────────────────────────────────
# LAN URL for this container — used in Homepage auto-discovery labels
# Set to your Unraid server's IP and the exposed port (default 8111)
RECIPE_PLANNER_URL=http://192.168.111.x:8111
