             headers=_headers(),
-            params={"queryFilter": f'orgURL = "{url}"', "perPage": 5},
+            params={"queryFilter": f'orgURL = "{_escape_filter_value(url)}"', "perPage": 5},
             timeout=_TIMEOUT,
